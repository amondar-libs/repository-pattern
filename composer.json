{
    "name": "amondar-libs/repository-pattern",
    "description": "Laravel package to implement the repository pattern.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sereda Oleg",
            "email": "zaxodu11@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.16",
        "amondar-libs/class-attributes": "^1.2",
        "spatie/laravel-data": "^4.18"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "mockery/mockery": "1.6.12",
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.24",
        "spatie/laravel-ray": "^1.41",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Amondar\\RepositoryPattern\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "ppest": "pest --parallel"
    }
}
